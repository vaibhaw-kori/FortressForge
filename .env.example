# ---- AURA-Install environment example ----
# Copy to .env and fill in values. Never commit .env.

# ---- App ----
NODE_ENV=development
AURA_ENV=dev
AURA_LOG_LEVEL=INFO
AURA_PUBLIC_BASE_URL=http://localhost:8000

# ---- Backend HTTP ----
AURA_BACKEND_HOST=0.0.0.0
AURA_BACKEND_PORT=8000

# ---- Database (SQLite for prototype; swap to Postgres later) ----
AURA_DATABASE_URL=sqlite:///./data/aura.db
# Production example:
# AURA_DATABASE_URL=postgresql://user:pass@localhost:5432/aura

# ---- Redis (queue + pubsub; optional in prototype) ----
AURA_REDIS_URL=redis://localhost:6379/0
AURA_QUEUE_ENABLED=false

# ---- Object storage (S3-compatible; MinIO locally) ----
AURA_S3_ENDPOINT=http://localhost:9000
AURA_S3_REGION=us-east-1
AURA_S3_ACCESS_KEY=minioadmin
AURA_S3_SECRET_KEY=minioadmin
AURA_S3_BUCKET_CAPTURES=aura-captures
AURA_S3_BUCKET_ASSETS=aura-assets
AURA_S3_BUCKET_GENERATED=aura-generated
AURA_S3_BUCKET_THUMBNAILS=aura-thumbnails
AURA_S3_PUBLIC_BASE_URL=http://localhost:9000

# ---- RunPod (serverless endpoints) ----
# Endpoint IDs and API keys. Never expose to frontends.
AURA_RUNPOD_API_KEY=
AURA_RUNPOD_ENDPOINT=mock
AURA_RUNPOD_ENDPOINT_FAKE=fake
AURA_RUNPOD_ENDPOINT_SVD=
AURA_RUNPOD_ENDPOINT_ANIMATEDIFF=
AURA_RUNPOD_PROVIDER_DEFAULT=mock
AURA_RUNPOD_TIMEOUT=30000
AURA_RUNPOD_POLL_INTERVAL=2000
AURA_INFERENCE_WARMUP_ON_BOOT=false
# Wan local — 14B 480P I2V (+ sequential CPU offload on 16GB GPUs).
# For A6000 48GB use Wan-AI/Wan2.1-I2V-14B-720P with AURA_WAN_OFFLOAD_TO_CPU=false.
# (when running GPU, set AURA_RUNPOD_PROVIDER_DEFAULT=wan-local)
AURA_WAN_PROVIDER_ENABLED=false
AURA_WAN_MODEL_REPO=Wan-AI/Wan2.1-I2V-14B-480P-Diffusers
AURA_WAN_PRECISION=bf16
AURA_WAN_LOCAL_PATH=
AURA_WAN_OFFLOAD_TO_CPU=false

# ---- Generation ----
AURA_GENERATION_TIMEOUT_MS=300000
AURA_GENERATION_MAX_ATTEMPTS=2

# ---- Auth (prototype values only) ----
AURA_OPERATOR_JWT_SECRET=change-me-in-prod
AURA_OPERATOR_JWT_TTL_SEC=900
AURA_KIOSK_TOKEN_DEFAULT=kiosk-dev-token
AURA_STORAGE_SIGNING_SECRET=change-me-storage-signing-secret
AURA_STORAGE_SIGNED_URL_TTL_SEC=3600

# ---- Retention (days) ----
AURA_RETENTION_CAPTURES_DAYS=7
AURA_RETENTION_GENERATED_DAYS=30

# ---- Rate limiting ----
AURA_RATE_LIMIT_REQUESTS_PER_MINUTE=60
AURA_RATE_LIMIT_BURST=20

# ---- Reel policy ----
AURA_REEL_POLICY_JSON={"insertMode":"fifo","maxGeneratedInQueue":3,"minGapBetweenGeneratedSeconds":60,"percentageOfReelForGenerated":30}

# ---- CORS ----
AURA_CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175